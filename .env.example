# Generate unique local secrets with python scripts/bootstrap_env.py. Never commit .env.
POSTGRES_PASSWORD=
CDIP_MIGRATOR_PASSWORD=
CDIP_APP_PASSWORD=
CDIP_BI_PASSWORD=
PREFECT_DB_PASSWORD=
METABASE_DB_PASSWORD=
METABASE_ENCRYPTION_SECRET_KEY=
CDIP_ADMIN_TOKEN=
CDIP_READER_TOKEN=
CDIP_SECRET_DEMO_WEBHOOK=
PREFECT_AUTH_STRING=
# Local Python processes only; Compose injects an internal connection URL.
# CDIP_DATABASE_URL=postgresql+psycopg://cdip_app:<secret>@localhost:5432/cdip

# Set true when the internal workspace is served over HTTPS.
CDIP_SECURE_COOKIES=false
